{
  "name": "language-exchange-diary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:data && npm run writing:qa && npm run typecheck && npm test && npm run build",
    "writing:import": "node scripts/import-writing.mjs",
    "writing:qa": "node scripts/writing-qa.mjs",
    "hangul:import": "node scripts/import-hangul.mjs",
    "test:browser": "node scripts/browser-qa.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "svg-path-properties": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
